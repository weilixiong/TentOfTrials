# Independent hand-written malformed/unsupported log lines
# These should NOT crash the parser and should return None
# Each line tests a specific edge case or known-bad format

# Empty line

# Whitespace only
   
# Not valid JSON (missing closing brace)
{"timestamp": "2024-01-15T08:30:00Z", "level": "INFO", "message": "broken json"

# Binary garbage
\x00\x01\xFF\xFE

# Valid JSON but not a dict (array)
[{"timestamp": "2024-01-15T08:30:00Z", "level": "INFO"}]

# Valid JSON but not a dict (string)
"just a string"

# Valid JSON but not a dict (number)
12345

# Valid JSON but not a dict (boolean)
true

# Nginx line missing critical fields (no status code)
192.168.1.1 - - [15/Jan/2024:08:30:00 +0000] "GET / HTTP/1.1"

# Nginx-like but with wrong date format
192.168.1.1 - - [2024-01-15 08:30:00] "GET / HTTP/1.1" 200 1234 "-" "curl/7.0"

# Extremely long message (parser should not crash)
2024-01-15 08:30:00 [stress-test] INFO 

# SQL injection attempt in log
2024-01-15 08:30:00 [api-gateway] ERROR SQL error: '; DROP TABLE users; -- 

# Null byte injection
2024-01-15 08:30:00 [api-gateway] INFO Normal log\x00with null byte

# Unicode edge case
2024-01-15 08:30:00 [api-gateway] INFO 测试日志 (Chinese test log)
